{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "docker build*": "ask",
      "curl *": "ask",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout -- *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "rm -rf*": "deny"
    }
  }
}
